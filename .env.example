# Copy to .env and adjust. All variables are optional; defaults shown below.

# Application name used in logs and the OpenAPI title.
APP_APP_NAME=doc-validator

# Python logging level: DEBUG, INFO, WARNING, ERROR.
APP_LOG_LEVEL=INFO

# DeepFace recognition model used for the similarity check.
APP_FACE_RECOGNITION_MODEL=VGG-Face

# DeepFace detector backend used to locate faces in the images.
APP_FACE_DETECTOR_BACKEND=retinaface

# Directory where multipart uploads are temporarily stored.
APP_UPLOAD_DIR=images
